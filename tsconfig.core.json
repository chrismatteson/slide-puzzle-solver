{
  // The reader and solver also run in Node and in workers; without DOM here, a browser API
  // (document, canvas, ...) used in src/vision or src/puzzle fails the type-check instead of creeping in.
  "extends": "./tsconfig.json",
  "compilerOptions": { "lib": ["ES2023"] },
  "include": ["src/vision/**/*.ts", "src/puzzle/**/*.ts", "src/picture/**/*.ts"]
}
