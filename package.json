{
  "name": "slide-puzzle-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen": "bash scripts/python-env.sh scripts/gen_photos.py --split eval --count 240 --seed 20240601 --out data/eval",
    "eval": "tsx scripts/eval.ts data/eval data/eval-results.json",
    "eval:seeds": "tsx scripts/eval-seeds.ts",
    "real:fetch": "tsx scripts/real-photos.ts fetch",
    "real:eval": "tsx scripts/real-photos.ts labels && tsx scripts/eval.ts data/real data/real-results.json",
    "pictures:fetch": "tsx scripts/picture-sources.ts fetch",
    "gen:picture": "bash scripts/python-env.sh scripts/gen_picture_photos.py --split eval --count 144 --seed 20261122 --out data/picture-eval",
    "eval:picture": "tsx scripts/eval-picture.ts data/picture-eval data/picture-eval-results.json",
    "train": "bash scripts/python-env.sh scripts/train_classifier.py",
    "e2e": "playwright test",
    "build-pattern-db": "tsx scripts/build-pattern-db.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "eslint": "10.15.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
